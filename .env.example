# Copy this file to .env and fill in your own values.
#   cp .env.example .env

# Required: bearer token for your Qwen chat-completions endpoint.
QWEN_KEY=

# Optional: override the API base URL (defaults to https://qwen.your-endpoint.example).
# QWEN_URL=

# Optional: override the model name (defaults to qwen3.8-27b).
# QWEN_MODEL=

# Optional: enables the run_python tool, which executes model-written code in
# an isolated E2B cloud sandbox. Get a key at https://e2b.dev. Without this,
# run_python calls will fail but everything else works normally.
E2B_API_KEY=
