# For developing skull from this checkout (`uv run chat.py`), copy this
# file to .env in your per-user config directory and fill in your own
# values - NOT to a .env next to this file, which a real installed `skull`
# command never reads (see README.md's Setup section for the exact path
# per platform, e.g. ~/.config/skull/.env on Linux).

# Required: your OpenAI-compatible chat-completions endpoint's base URL.
# e.g. https://api.openai.com/v1 or https://generativelanguage.googleapis.com/v1beta/openai
# for Gemini, or any self-hosted OpenAI-compatible endpoint.
LLM_URL=

# Required: bearer token / API key for that endpoint.
LLM_KEY=

# Required: model name for that endpoint (e.g. gpt-5, gemini-2.5-pro).
LLM_MODEL=

# Optional: enables the run_python tool, which executes model-written code in
# an isolated E2B cloud sandbox. Get a key at https://e2b.dev. Without this,
# run_python calls will fail but everything else works normally.
E2B_API_KEY=
